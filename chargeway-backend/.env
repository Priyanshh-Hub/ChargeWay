# =============================================
# ChargeWay Backend - Environment Variables
# =============================================
# STEP 1: Copy this file and rename it to .env
# STEP 2: Fill in your MongoDB connection string
# STEP 3: Save the file
# =============================================

# --- MongoDB Connection String ---
# Option A: MongoDB Atlas (cloud) - replace with your actual string
MONGO_URI=mongodb://localhost:27017/chargeway
# Option B: Local MongoDB (uncomment this line and comment out the line above)
# MONGO_URI=mongodb://localhost:27017/chargeway

# --- JWT Secret Key ---
# Use any long random string here (minimum 32 characters)
JWT_SECRET=chargeway_super_secret_jwt_key_change_this_before_going_live

# --- Server Port ---
PORT=5000

# --- Environment ---
# Change to "production" when you deploy live
NODE_ENV=development
