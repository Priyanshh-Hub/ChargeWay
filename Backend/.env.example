# Copy this file to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb://localhost:27017/chargeway
JWT_SECRET=replace_with_a_long_random_string
PORT=5000
NODE_ENV=development

# Required to call POST /api/seed (dev-only demo data). Without this set,
# the seed route is unauthenticated on any reachable dev/staging server.
SEED_SECRET=replace_with_a_random_string

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to localhost dev ports if unset — set this for any deployed environment.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Razorpay (test/sandbox mode is free — no KYC needed). Get these from
# your Razorpay dashboard → Settings → API Keys → Generate Test Key.
# Without these set, /api/payments/* returns a clear "not configured" error
# instead of crashing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Public URL of the deployed frontend — used to build links inside emails
# (e.g. https://app.chargeway.com). Defaults to http://localhost:5173.
APP_URL=http://localhost:5173

# SMTP — sends real verification/reset emails. Works with any provider
# that exposes SMTP creds (Gmail app password, Resend, SendGrid, SES,
# Mailgun...). Without these set, links are logged to the console and
# returned in the API response instead (dev-only fallback, unchanged
# from before).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password
EMAIL_FROM=ChargeWay <no-reply@chargeway.app>

# Google Sign-In — create an OAuth Client ID (Web application) at
# console.cloud.google.com → APIs & Services → Credentials. Use the same
# value as VITE_GOOGLE_CLIENT_ID in the frontend .env. Without this set,
# the Google button shows a clear "not configured" message instead of
# silently failing.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional — only needed once you run more than one backend instance.
# Without it, rate limiting falls back to in-memory (fine for a single
# process). Get a free Redis instance from Upstash or Redis Cloud.
REDIS_URL=
